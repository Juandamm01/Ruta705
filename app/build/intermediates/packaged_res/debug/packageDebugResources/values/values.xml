<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bone">#F7F4EC</color>
    <color name="gold_accent">#F2B705</color>
    <color name="ic_launcher_background">#0D3B36</color>
    <color name="ink_dark">#16211F</color>
    <color name="teal_dark">#0D3B36</color>
    <string name="app_name">Ruta705</string>
    <string name="channel_route_updates">Novedades de tus rutas</string>
    <string name="channel_route_updates_description">Reportes de la comunidad y avisos sobre las rutas que guardaste.</string>
    <style name="Theme.Ruta705" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bone</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
