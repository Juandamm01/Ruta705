<?xml version="1.0" encoding="utf-8"?>
<!-- Producción: solo HTTPS. La variante debug (src/debug) permite HTTP hacia el backend local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
