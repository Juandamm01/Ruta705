<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ruta705" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bone</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ruta705.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ruta705</item>
    </style>
</resources>
